# =========================================================
# ErrorLens environment configuration
# Copy this file to `.env` and fill in your values.
# NEVER commit a real `.env` file or API keys.
# =========================================================

# --- LLM (OpenAI-compatible API) -----------------------------------------
# API key for the OpenAI-compatible endpoint. Required for POST /api/analyze.
# Examples: sk-... (OpenAI), your LM Studio / Ollama / OpenRouter key.
LLM_API_KEY=

# Base URL of the OpenAI-compatible API.
# Leave empty to use OpenAI's default (https://api.openai.com/v1).
# Local examples:
#   Ollama:     http://localhost:11434/v1
#   LM Studio:  http://localhost:1234/v1
LLM_BASE_URL=

# Model name. Defaults to gpt-4o-mini when empty.
# Local examples: llama3.2, qwen2.5, gpt-oss:120b
LLM_MODEL=gpt-4o-mini

# Sampling temperature for the diagnosis (lower = more deterministic).
LLM_TEMPERATURE=0.2

# --- Embedding model ------------------------------------------------------
# sentence-transformers model used for RAG embeddings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- ErrorLens runtime ----------------------------------------------------
# Port/host for the FastAPI server.
ERRORLENS_PORT=8000
ERRORLENS_HOST=0.0.0.0

# Top-k chunks retrieved per analysis.
ERRORLENS_TOP_K=6